1,1               ! A-Tar and Z-Tar
1,1               ! nuclear pdf parameter1: nucleon mass number A, charge number Z
201               ! nuclear pdf parameter2: correction order x*100+y x= 1:LO, 2:NLO y:error set
! PMAS(4,1)=1.27    ! charm mass
MSEL=0
MSTP(14)=1
MSUB(11)=1
